PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?appName=<app>
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=7d
CLIENT_URLS=https://your-client.vercel.app,https://your-admin.vercel.app

# Cloudinary Config (required for admin food/category image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Config (for OTP & password reset)
# Gmail: use an App Password (not your regular password)
#   Get one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Chulha Kitchen" <noreply@chulha.com>
